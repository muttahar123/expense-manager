{
  "name": "wealth-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Wealth & Expense Manager — unified Vercel deploy (React frontend + Express serverless API) on Supabase + Google Auth.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev:server": "node --watch server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js"
  },
  "keywords": [
    "mern",
    "expense",
    "wealth",
    "finance",
    "supabase",
    "vercel"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  }
}
