# ============================================================================
#  👉  THE ONLY FILE YOU NEED TO EDIT TO GET THE APP RUNNING  👈
# ============================================================================
#
#  SETUP (one time, ~5 minutes):
#
#  1. Copy this file to ".env"           ->   cp .env.example .env
#
#  2. Create a free Supabase project at  https://supabase.com
#       - In the SQL Editor, paste & run the contents of  supabase/schema.sql
#       - Go to  Project Settings -> API  and copy the 3 values below.
#
#  3. Turn on Google login (Supabase handles the Google OAuth for you):
#       - Supabase dashboard ->  Authentication -> Providers -> Google -> Enable
#       - Paste your Google OAuth "Client ID" and "Client Secret"
#         (create them at  https://console.cloud.google.com  ->
#          APIs & Services -> Credentials -> OAuth client ID -> Web application).
#       - In that Google OAuth client, add this Authorized redirect URI (shown
#         on the Supabase Google provider screen):
#            https://<your-project-ref>.supabase.co/auth/v1/callback
#       - Back in Supabase -> Authentication -> URL Configuration, add your app
#         URLs to "Redirect URLs" (e.g. http://localhost:5173 and your
#         https://<app>.vercel.app URL).
#
#  4. Fill in the 3 values below, save, and run the app. That's it.
#
#  NOTE: the Google Client ID/Secret live INSIDE Supabase (step 3), not here.
#        This file only needs the 3 Supabase keys below.
#
#  DEPLOYING TO VERCEL: add these SAME 3 variables in
#     Vercel -> Project -> Settings -> Environment Variables
#  (same names, same values). Nothing else changes.
# ============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# "anon" / public key — safe to expose to the browser.
SUPABASE_ANON_KEY=

# "service_role" key — SERVER ONLY, keep secret. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
